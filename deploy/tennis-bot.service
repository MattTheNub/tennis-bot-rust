[Unit]
Description=Discord Tennis Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tennis-bot
Group=tennis-bot
WorkingDirectory=/opt/tennis-bot
EnvironmentFile=/etc/tennis-bot.env
Environment=RUST_LOG=tennis_bot=info,warn
ExecStart=/opt/tennis-bot/current/tennis-bot
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
LimitCORE=0
UMask=0077

[Install]
WantedBy=multi-user.target
